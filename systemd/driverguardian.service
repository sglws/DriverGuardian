[Unit]
# A user service, so it starts inside the desktop session (camera, audio, Bluetooth speaker).
Description=DriverGuardian driver monitoring system
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/DriverGuardian
ExecStart=%h/DriverGuardian/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5

[Install]
# default.target: graphical-session.target is not a valid install target for user units.
WantedBy=default.target
