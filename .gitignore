# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- Virtual environment ---
.venv/
venv/
env/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Runtime artifacts (regenerated every run, not useful in history) ---
logs/*.csv
outputs/*
!outputs/.gitkeep

# --- Training artifacts (large, fully regenerable from the dataset) ---
training/runs/

# --- Dataset images/labels: can grow to thousands of files (Phase 9-10) -
# use Roboflow/DVC/Git LFS for these instead of committing raw data. Keep
# the folder structure and data.yaml tracked.
datasets/train/images/*
datasets/train/labels/*
datasets/valid/images/*
datasets/valid/labels/*
datasets/test/images/*
datasets/test/labels/*
!datasets/**/.gitkeep

# --- Model weights: keep the small pretrained baseline and the current
# deployed fine-tuned model - the dataset that trained best.pt isn't in this
# repo (see datasets/ rules above), so it's not actually regenerable from
# what's here; committing it (it's small, ~5MB) is what keeps a fresh clone
# actually functional. Ignore other/future .pt files (retraining experiments,
# checkpoints) so those don't get committed by accident. ---
models/*.pt
!models/yolo11n.pt
!models/best.pt
